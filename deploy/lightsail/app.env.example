# Settings for the Starhub RMF container on the Lightsail instance.
# setup.sh copies this to /etc/starhub-rmf/app.env (readable by root only) and fills in
# PUBLIC_SITE_URL. Replace every CHANGE-ME, then run setup.sh again. Write values without quotes.

NODE_ENV=production
# Caddy terminates HTTPS on this machine and sets X-Forwarded-Proto/Host.
TRUST_PROXY=true
# Public URL, shown to vendors as the callback base (https://<host>).
PUBLIC_SITE_URL=https://CHANGE-ME

# Same as in your .env.local.
SUPABASE_URL=CHANGE-ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE-ME
# A new random string for this server (32+ characters): openssl rand -base64 48
SESSION_SECRET=CHANGE-ME

# Hourly Keenon re-sync. Set to true once Keenon has whitelisted this server's static IP.
KEENON_SCHEDULED_SYNC=false
