# Copy to .env.local and fill in. Never commit real values.
# Supabase -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase -> Project Settings -> API Keys -> Secret key (sb_secret_...) or legacy service_role key
SUPABASE_SERVICE_ROLE_KEY=
# Random string, 32+ bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Public URL vendors (e.g. Keenon) call back to. Shown on vendor config pages.
# Locally: your ngrok static domain (see README, "Receiving real callbacks on your machine"). Deployed: set in /etc/starhub-rmf/app.env on the Lightsail instance instead.
PUBLIC_SITE_URL=https://your-name.ngrok-free.dev
# Set to "true" to re-sync Keenon robots hourly (needs a whitelisted outbound IP; off by default)
# KEENON_SCHEDULED_SYNC=true
