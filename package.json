{
  "name": "starhub-rmf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file=.env.local --import tsx server/main.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build && node scripts/build-server.mjs",
    "start": "node dist-server/main.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview",
    "job:maintenance": "node --env-file=.env.local dist-server/maintenance.mjs",
    "create-user": "tsx --env-file=.env.local scripts/create-user.ts",
    "keenon:mock": "tsx scripts/keenon-mock.ts",
    "keenon:callbacks": "tsx scripts/keenon-send-callbacks.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.14",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
